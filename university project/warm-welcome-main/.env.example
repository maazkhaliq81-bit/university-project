# Supabase — Dashboard > Project Settings > API
# Project ref (from the URL: https://<ref>.supabase.co)
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_URL="https://your-project-ref.supabase.co"
# Publishable key (sb_publishable_...) or legacy anon key. Safe for the browser.
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
# Secret key (sb_secret_...) or legacy service_role key. SERVER ONLY — never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY="sb_secret_xxx"

# Browser copies (Vite only exposes VITE_* to client code)
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"

# AI features — Groq (https://console.groq.com/keys). SERVER ONLY.
GROQ_API_KEY="gsk_xxx"
